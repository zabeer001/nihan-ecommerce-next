# Use a Laravel origin reachable from the Next.js container.
NIHAN_CATALOG_API_URL=http://host.docker.internal:97
# Use a Laravel origin reachable from the shopper’s browser.
NIHAN_LARAVEL_PUBLIC_URL=http://localhost:97
NIHAN_HERO_VIDEO_ID=
PORT=1008

# Optional: Google Tag Manager container (set before building).
NEXT_PUBLIC_GTM_ID=
